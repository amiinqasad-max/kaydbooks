{
  "expo": {
    "name": "Kayd Books",
    "slug": "kayd-books",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "53.0.0",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-font",
      "expo-asset",
      "expo-av",
      "expo-video"
    ]
  }
}
