# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real credentials.
#
# These EXPO_PUBLIC_* variables are inlined into the built app bundle by
# Expo, so ONLY put values here that are safe for every user's device to
# see (the anon/public key). NEVER put a service_role key, or any other
# server-only secret, in a variable prefixed EXPO_PUBLIC_.

# Supabase Dashboard > Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard > Settings > API > Project API keys > "anon" "public"
# This key is safe to ship in the app ONLY because every table it can touch
# is protected by a Row Level Security policy (see
# supabase/migrations/003_authorization_and_schema_fixes.sql). If RLS is
# ever disabled on a table, this key stops being safe to ship.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------
# The variables below are SERVER-ONLY. They belong in the Supabase Edge
# Function secrets store (`supabase secrets set NAME=value`), never in this
# app's .env, never prefixed EXPO_PUBLIC_, and never committed anywhere.
# Listed here only so it's documented what each function needs.
# -----------------------------------------------------------------------

# supabase/functions/verify-receipt and verify-local-payment:
#   SUPABASE_URL                 (auto-provided by Supabase in edge runtime)
#   SUPABASE_SERVICE_ROLE_KEY    (auto-provided by Supabase in edge runtime;
#                                 do not copy it anywhere else)
#   APPLE_SHARED_SECRET          (App Store Connect > your app > App
#                                 Information > App-Specific Shared Secret)
#   GOOGLE_SERVICE_ACCOUNT_KEY   (Google Play Console service account JSON,
#                                 as a single-line string, with
#                                 "Financial data" / "Manage orders and
#                                 subscriptions" access granted)
#   GOOGLE_PACKAGE_NAME          (e.g. com.kaydbooks.app)

# admin_web/config.js:
#   Uses the SAME anon key as the mobile app above. The admin panel no
#   longer uses or needs a service-role key -- admin authorization is
#   enforced by the profiles.role RLS policy, not by a special client.
